{
  "name": "webflux",
  "version": "0.1.0",
  "private": true,
  "description": "WebFlux — prediction market prop firm infrastructure",
  "scripts": {
    "dev:web": "pnpm --filter oracle-funded dev",
    "dev:worker": "pnpm --filter @webflux/worker dev",
    "build": "pnpm --filter oracle-funded build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
