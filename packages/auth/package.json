{
  "name": "@webflux/auth",
  "version": "0.1.0",
  "private": true,
  "description": "JWT auth utilities: Supabase JWT verification (JWKS), auth context enrichment, and route middleware",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@webflux/db": "workspace:*",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@prisma/client": "^5.14.0",
    "@types/node": "^25.6.0",
    "typescript": "^5.4.5"
  }
}
